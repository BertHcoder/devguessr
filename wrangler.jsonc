{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devguessr",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true },
  // Cloudflare creates the DNS record and certificate for this hostname.
  "routes": [{ "pattern": "devguessr.itaanhuys.com", "custom_domain": true }],
}
